# Optional. Without these, the app returns matching source excerpts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
# Supabase Auth: backend-only project settings. No service-role key is needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact website origin, used for CSRF validation and HTTPS Secure cookies.
APP_ORIGIN=http://127.0.0.1:3000

# Backend-only PostgreSQL URI. Supabase session pooler or direct connection.
# Apply migration 002 before enabling; never use a browser NEXT_PUBLIC variable.
DATABASE_URL=
EMBEDDING_MODEL=gemini-embedding-001

# sqlite for a credential-free local demo; postgres after migrate_storage completes.
DOCUMENT_BACKEND=sqlite

RATE_LIMIT_ENABLED=1
CHAT_REQUESTS_PER_MINUTE=30
ADMIN_REQUESTS_PER_MINUTE=120

AUTH_REQUESTS_PER_MINUTE=10
