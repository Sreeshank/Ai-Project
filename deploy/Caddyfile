{
    log default {
        output stdout
        format filter {
            request>headers delete
            request>uri delete
            resp_headers delete
            wrap json
        }
    }
}

{$CAMPUS_DOMAIN} {
    encode zstd gzip
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
    log {
        output stdout
        format filter {
            request>headers delete
            request>uri delete
            resp_headers delete
            wrap json
        }
    }
}
